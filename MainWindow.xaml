<Window x:Class="NavalArchitectureSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NavalArchitectureSuite"
        mc:Ignorable="d"
        Title="Naval Architecture Engineering Suite v1.0"
        Icon="naval_architecture_suite.ico"
        Height="720" Width="1280"
        MinHeight="650" MinWidth="1280"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Background="#0A1F3D"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Navigation button style: icon badge + label, gold accent bar when selected -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D7E1F0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="AccentBar" Grid.Column="0" Fill="#C8960C" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                   VerticalAlignment="Center" Margin="18,0,10,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#132C56"/>
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#F2C94C"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20396B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1B3A6B" BorderBrush="#C8960C" BorderThickness="0,0,0,2">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="naval_architecture_suite_64.png" Width="40" Height="40" Stretch="Uniform"/>
                    <TextBlock Text="Naval Architecture Engineering Suite v1.0" Foreground="White" FontSize="22"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: sidebar + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#1B3A6B">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,10" x:Name="NavPanel">

                        <RadioButton x:Name="BtnShipBuilder" Tag="ShipBuilder" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Ship Builder"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnHydrostatics" Tag="Hydrostatics" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Hydrostatics"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnResistance" Tag="Resistance" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Resistance and Propulsion" TextWrapping="Wrap" Width="180"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnMachinery" Tag="Machinery" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Machinery"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnStability" Tag="Stability" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Stability"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnDamageStability" Tag="DamageStability" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Damage Stability" TextWrapping="Wrap" Width="180"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnWelding" Tag="Welding" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Welding"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnYachtDesign" Tag="YachtDesign" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Yacht Design"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnLngSystems" Tag="LngSystems" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="LNG Systems"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnManoeuvring" Tag="Manoeuvring" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Manoeuvring"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnTonnageFreeboard" Tag="TonnageFreeboard" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Tonnage and Freeboard" TextWrapping="Wrap" Width="180"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnBowDesign" Tag="BowDesign" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Bow Design"/>
                        </RadioButton>
                        <RadioButton x:Name="BtnReports" Tag="Reports" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavButton_Checked">
                            <TextBlock Text="Reports"/>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Content frame -->
            <Border Grid.Column="1" Background="#0A1F3D">
                <ContentControl x:Name="ContentFrame"/>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#1B3A6B" BorderBrush="#C8960C" BorderThickness="0,1,0,0">
            <TextBlock Text="28 Volumes | 3358 Live Formulas | Alper Alacam | Turkiye | 2026 | v1.0"
                       Foreground="#C8960C" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
