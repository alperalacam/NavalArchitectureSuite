<Window x:Class="NavalArchitectureSuite.Views.HullViewportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="3D Hull Viewport — Naval Architecture Engineering Suite"
        Width="1100" Height="750"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#0A1F3D"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1B3A6B"/>
            <Setter Property="Foreground" Value="#F2C94C"/>
            <Setter Property="BorderBrush" Value="#C8960C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24467F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#122A52" BorderBrush="#24467F" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="3D Hull Viewport" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VesselInfoText" Foreground="#8FA6C9" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Reset View"  Click="ResetView_Click"  Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Top View"    Click="TopView_Click"    Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Side View"   Click="SideView_Click"   Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Front View"  Click="FrontView_Click"  Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Fit to View" Click="FitView_Click"    Style="{StaticResource ToolbarButtonStyle}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Heel Angle Slider -->
        <Border Grid.Row="1" Background="#0E2545" BorderBrush="#24467F" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⟳  Heel Angle" Foreground="#8FA6C9" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Slider Grid.Column="1" Minimum="-45" Maximum="45"
                        Value="{Binding HeelAngle, Mode=TwoWay}"
                        VerticalAlignment="Center" TickFrequency="5"
                        IsSnapToTickEnabled="False" Foreground="#C8960C"/>
                <TextBlock Grid.Column="2" Foreground="#F2C94C" FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="12,0,6,0"
                           Text="{Binding HeelAngle, StringFormat='{}{0:F1}°'}"/>
                <Button Grid.Column="3" Content="Upright" Click="Upright_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Reset heel to 0°"/>
            </Grid>
        </Border>

        <!-- 3D Viewport -->
        <h:HelixViewport3D x:Name="Viewport"
                           Grid.Row="2"
                           Background="#000000"
                           ZoomExtentsWhenLoaded="True"
                           ShowCoordinateSystem="True"
                           CoordinateSystemHorizontalPosition="Left"
                           CoordinateSystemVerticalPosition="Bottom"
                           CoordinateSystemWidth="70"
                           CoordinateSystemLabelForeground="White"
                           ShowViewCube="True"
                           ViewCubeHorizontalPosition="Right"
                           ViewCubeVerticalPosition="Top">
            <h:HelixViewport3D.Camera>
                <PerspectiveCamera Position="0,0,1000" LookDirection="0,0,-1" UpDirection="1,0,0" FieldOfView="45"/>
            </h:HelixViewport3D.Camera>
            <h:SunLight/>
            <ModelVisual3D Content="{Binding HullModel}">
                <ModelVisual3D.Transform>
                    <RotateTransform3D>
                        <RotateTransform3D.Rotation>
                            <AxisAngleRotation3D Axis="1,0,0" Angle="{Binding HeelAngle}"/>
                        </RotateTransform3D.Rotation>
                    </RotateTransform3D>
                </ModelVisual3D.Transform>
            </ModelVisual3D>
            <h:BillboardTextVisual3D Text="BOW"       Foreground="#C8960C" FontWeight="Bold" FontSize="18" Position="{Binding BowLabelPosition}"/>
            <h:BillboardTextVisual3D Text="STERN"     Foreground="#C8960C" FontWeight="Bold" FontSize="18" Position="{Binding SternLabelPosition}"/>
            <h:BillboardTextVisual3D Text="PORT"      Foreground="#C8960C" FontWeight="Bold" FontSize="18" Position="{Binding PortLabelPosition}"/>
            <h:BillboardTextVisual3D Text="STARBOARD" Foreground="#C8960C" FontWeight="Bold" FontSize="18" Position="{Binding StarboardLabelPosition}"/>
        </h:HelixViewport3D>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#122A52" BorderBrush="#24467F" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock Foreground="#8FA6C9" FontSize="11"
                       Text="Drag to rotate  •  Scroll to zoom  •  Right-drag to pan  •  Heel slider rotates hull around longitudinal axis"/>
        </Border>
    </Grid>
</Window>
