<UserControl x:Class="NavalArchitectureSuite.Views.DamageStabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:local="clr-namespace:NavalArchitectureSuite.Views"
             mc:Ignorable="d"
             d:DesignWidth="1220" d:DesignHeight="1000">
    <UserControl.Resources>

        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#122A52"/>
            <Setter Property="BorderBrush" Value="#24467F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8960C"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA6C9"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0A1F3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#C8960C"/>
            <Setter Property="BorderBrush" Value="#24467F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SelectionBrush" Value="#C8960C"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#C8960C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D7E1F0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatTileStyle" TargetType="Border">
            <Setter Property="Background" Value="#0E2545"/>
            <Setter Property="BorderBrush" Value="#24467F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA6C9"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2C94C"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="GmdValueStyle" TargetType="TextBlock" BasedOn="{StaticResource StatValueStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding GmDamagedIsPositive}" Value="False">
                    <Setter Property="Foreground" Value="#E05263"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CriteriaBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Background" Value="#3D1620"/>
            <Setter Property="BorderBrush" Value="#E05263"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPass}" Value="True">
                    <Setter Property="Background" Value="#123D2A"/>
                    <Setter Property="BorderBrush" Value="#3DDC84"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CriteriaBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E05263"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPass}" Value="True">
                    <Setter Property="Foreground" Value="#3DDC84"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CriteriaColTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D7E1F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ConditionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#1E3B6B" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B3A6B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#152F5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConditionListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#0A1F3D"/>
            <Setter Property="BorderBrush" Value="#24467F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ConditionListBoxItemStyle}"/>
        </Style>

        <Style x:Key="SmallActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1B3A6B"/>
            <Setter Property="Foreground" Value="#F2C94C"/>
            <Setter Property="BorderBrush" Value="#C8960C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20396B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IndexBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Background" Value="#3D1620"/>
            <Setter Property="BorderBrush" Value="#E05263"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AttainedIndexPass}" Value="True">
                    <Setter Property="Background" Value="#123D2A"/>
                    <Setter Property="BorderBrush" Value="#3DDC84"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndexBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E05263"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AttainedIndexPass}" Value="True">
                    <Setter Property="Foreground" Value="#3DDC84"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="36,28,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Module header -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
            <Border Width="56" Height="56" CornerRadius="28" Background="#1B3A6B" BorderBrush="#C8960C" BorderThickness="2">
                <TextBlock Text="DS" Foreground="#C8960C" FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Damage Stability" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="SOLAS Damage Stability &amp; Probabilistic Method" FontSize="14" Foreground="#C8960C" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Grid.Row="1" Height="1" Fill="#24467F" Margin="0,20,0,20"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= INPUTS ================= -->
                <StackPanel Grid.Column="0">

                    <!-- Damage case manager -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Damage Cases" Style="{StaticResource SectionTitleStyle}"/>

                            <ListBox x:Name="CaseListBox" Style="{StaticResource ConditionListBoxStyle}"
                                     ItemsSource="{Binding DamageCases}"
                                     SelectedItem="{Binding SelectedCase, Mode=TwoWay}"
                                     MaxHeight="170" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#D7E1F0"/>
                                                <TextBlock Text="{Binding X1, StringFormat={}X1 {0:F1} m}" FontSize="11" Foreground="#8FA6C9" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="RemoveCase_Click"
                                                    Style="{StaticResource SmallActionButtonStyle}" Padding="6,2" FontSize="10"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Content="+ Add Damage Case" Click="AddCase_Click" Style="{StaticResource SmallActionButtonStyle}"
                                    HorizontalAlignment="Stretch" Margin="0,10,0,0"/>

                            <Rectangle Height="1" Fill="#24467F" Margin="0,16,0,4"/>

                            <TextBlock Text="Selected Case" Style="{StaticResource InputLabelStyle}" Margin="0,10,0,4"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding SelectedCase.Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="X1 — Forward Boundary from AP (m)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding SelectedCase.X1, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>

                            <TextBlock Text="X2 — Aft Boundary from AP (m)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding SelectedCase.X2, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>

                            <TextBlock Text="Permeability, µ" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding SelectedCase.Permeability, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>

                            <TextBlock Text="Probability Weight (relative)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding SelectedCase.ProbabilityWeight, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                        </StackPanel>
                    </Border>

                    <!-- Hull / loading inputs -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Hull &amp; Loading (Intact)" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Lpp — Length Between Perpendiculars (m)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding Lpp, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>

                            <TextBlock Text="Bwl — Waterline Beam (m)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding Bwl, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>

                            <TextBlock Text="D — Moulded Depth (m)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding Depth, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>

                            <TextBlock Text="T — Intact Mean Draft (m)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding IntactDraftT, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/>

                            <TextBlock Text="Cb — Block Coefficient" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding Cb, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/>

                            <TextBlock Text="Cwp — Waterplane Coefficient" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding Cwp, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/>

                            <TextBlock Text="KG — Height of C.G. above Keel (m)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding Kg, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/>

                            <TextBlock Text="Displacement, Δ (t, salt water)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding Displacement, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"/>

                            <TextBlock Text="Damaged draft/KB/BM are recomputed per case from a prismatic lost-buoyancy approximation (see code comments). KG is assumed unchanged by flooding."
                                       Foreground="#8FA6C9" FontSize="10.5" TextWrapping="Wrap" Margin="0,16,0,0" Opacity="0.8"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ================= OUTPUTS ================= -->
                <StackPanel Grid.Column="2">

                    <!-- Selected-case results -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Selected Case — Damaged Condition" Style="{StaticResource SectionTitleStyle}"/>
                            <ItemsControl>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="DAMAGED DRAFT (Td)" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding DamagedDraftTd, StringFormat={}{0:F3} m}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="SINKAGE (ΔT)" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding Sinkage, StringFormat={}{0:F3} m}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="KMd" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding KmDamaged, StringFormat={}{0:F3} m}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="GMd" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding GmDamaged, StringFormat={}{0:F3} m}" Style="{StaticResource GmdValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="MAX GZ" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding MaxGz, StringFormat={}{0:F3} m}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="RANGE" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding RangeOfPositiveStability, StringFormat={}{0:F1}°}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                            </ItemsControl>

                            <TextBlock Text="Damage is assumed symmetric about the centreline — no list angle from off-centre flooding is modelled. This upright residual condition will overstate stability for any real asymmetric damage case."
                                       Foreground="#8FA6C9" FontSize="10.5" TextWrapping="Wrap" Margin="0,14,0,0" Opacity="0.8"/>

                            <TextBlock Foreground="#E05263" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Warning: damaged draft has reached the moulded depth — deck edge is approximately immersed."
                                       Visibility="{Binding DeckEdgeImmersed, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Residual GZ curve -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Residual GZ Curve (Wall-Sided Approximation)" Style="{StaticResource SectionTitleStyle}"/>
                            <oxy:PlotView Model="{Binding GzPlotModel}" Height="280" Background="Transparent"/>
                        </StackPanel>
                    </Border>

                    <!-- Per-case attained index table -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Per-Case Results" Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Margin="4,0,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Case" Foreground="#8FA6C9" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Td" Foreground="#8FA6C9" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="GMd" Foreground="#8FA6C9" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="si" Foreground="#8FA6C9" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="4" Text="pi" Foreground="#8FA6C9" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding CaseResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1E3B6B" BorderThickness="0,0,0,1" Padding="4,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding CaseName}" Style="{StaticResource CriteriaColTextStyle}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Td, StringFormat={}{0:F2} m}" Style="{StaticResource CriteriaColTextStyle}" Foreground="#8FA6C9"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Gmd, StringFormat={}{0:F2} m}" Style="{StaticResource CriteriaColTextStyle}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SFactor, StringFormat={}{0:F3}}" Style="{StaticResource CriteriaColTextStyle}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Pi, StringFormat={}{0:F3}}" Style="{StaticResource CriteriaColTextStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Attained vs required index -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Attained Index A vs Required Index R (SOLAS II-1 Reg 6/7-2, simplified)" Style="{StaticResource SectionTitleStyle}" Margin="0" TextWrapping="Wrap"/>
                                <Border Grid.Column="1" Style="{StaticResource IndexBadgeStyle}">
                                    <TextBlock Text="{Binding IndexStatusText}" Style="{StaticResource IndexBadgeTextStyle}"/>
                                </Border>
                            </Grid>

                            <ItemsControl>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="ATTAINED INDEX, A" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding AttainedIndex, StringFormat={}{0:F3}}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="REQUIRED INDEX, R" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding RequiredIndex, StringFormat={}{0:F3}}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                            </ItemsControl>

                            <TextBlock Foreground="#8FA6C9" FontSize="10.5" TextWrapping="Wrap" Margin="0,14,0,0" Opacity="0.8"
                                       Text="A = Σ(pi·si) over the listed damage cases only (pi = each case's probability weight normalized to sum to 1; si uses a simplified single-case s-factor). R = 1 − 1/(1 + Lpp/100) is a simplified single-variable stand-in for SOLAS II-1 Reg 6, which in the full regulation also depends on ship type and the persons-on-board factors N1/N2. Provided for preliminary / teaching purposes — this is not the full probabilistic method (exhaustive damage zones/combinations) and must not be used for class or flag-state submissions."/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
