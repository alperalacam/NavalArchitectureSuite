<UserControl x:Class="NavalArchitectureSuite.Views.ShipBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:vm="clr-namespace:NavalArchitectureSuite.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1180" d:DesignHeight="820">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#122A52"/>
            <Setter Property="BorderBrush" Value="#24467F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8960C"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA6C9"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0A1F3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#C8960C"/>
            <Setter Property="BorderBrush" Value="#24467F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionBrush" Value="#C8960C"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#C8960C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InputComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#D7E1F0"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24467F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20396B"/>
                                <Setter Property="Foreground" Value="#F2C94C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0A1F3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#24467F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource InputComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="#C8960C"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#1B3A6B" BorderBrush="#C8960C" BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatTileStyle" TargetType="Border">
            <Setter Property="Background" Value="#0E2545"/>
            <Setter Property="BorderBrush" Value="#24467F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA6C9"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2C94C"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="ViewportToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1B3A6B"/>
            <Setter Property="Foreground" Value="#F2C94C"/>
            <Setter Property="BorderBrush" Value="#C8960C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24467F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewportSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="#0A1F3D"/>
            <Setter Property="BorderBrush" Value="#24467F"/>
            <Setter Property="BorderThickness" Value="1,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C8960C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="36,28,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="56" Height="56" CornerRadius="28" Background="#1B3A6B"
                    BorderBrush="#C8960C" BorderThickness="2">
                <TextBlock Text="SB" Foreground="#C8960C" FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Ship Builder" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Vessel Parameters — Master Input Sheet" FontSize="14"
                           Foreground="#C8960C" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Grid.Row="1" Height="1" Fill="#24467F" Margin="0,20,0,20"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="260" MaxWidth="480"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Principal Dimensions" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Vessel Type" Style="{StaticResource InputLabelStyle}"/>
                            <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                      ItemsSource="{x:Static vm:ShipBuilderViewModel.VesselTypeNames}"
                                      SelectedItem="{Binding VesselType}"/>
                            <TextBlock Text="Lpp — Length Between Perpendiculars (m)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding Lpp, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                            <TextBlock Text="B — Breadth Moulded (m)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding Breadth, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                            <TextBlock Text="D — Depth Moulded (m)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding Depth, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                            <TextBlock Text="T — Draft Moulded (m)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                            <TextBlock Text="V — Design Speed (knots)" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding DesignSpeed, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Hull Form Coefficients" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Cb — Block Coefficient" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding Cb, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/>
                            <TextBlock Text="Cm — Midship Coefficient" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding Cm, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/>
                            <TextBlock Text="Cwp — Waterplane Area Coefficient" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding Cwp, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/>
                            <TextBlock Text="Cp — Entered Prismatic Coefficient" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding EnteredCp, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE"
                               Style="{StaticResource ViewportSplitterStyle}"/>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="3D Hull Preview" Style="{StaticResource SectionTitleStyle}"/>
                            <WrapPanel Margin="0,0,0,2">
                                <Button x:Name="ResetViewButton" Content="Reset View" Click="ResetViewButton_Click"
                                        Style="{StaticResource ViewportToolbarButtonStyle}"
                                        ToolTip="Return to the default isometric angle"/>
                                <Button x:Name="TopViewButton" Content="Top View" Click="TopViewButton_Click"
                                        Style="{StaticResource ViewportToolbarButtonStyle}"
                                        ToolTip="Plan view from above"/>
                                <Button x:Name="SideViewButton" Content="Side View" Click="SideViewButton_Click"
                                        Style="{StaticResource ViewportToolbarButtonStyle}"
                                        ToolTip="Profile view from starboard"/>
                                <Button x:Name="FrontViewButton" Content="Front View" Click="FrontViewButton_Click"
                                        Style="{StaticResource ViewportToolbarButtonStyle}"
                                        ToolTip="Body plan view from the bow"/>
                                <Button x:Name="FitToScreenButton" Content="Fit to Screen" Click="FitToScreenButton_Click"
                                        Style="{StaticResource ViewportToolbarButtonStyle}"
                                        ToolTip="Zoom to fit the hull in view"/>
                            </WrapPanel>
                            <Border BorderBrush="#24467F" BorderThickness="1" CornerRadius="4" Background="#0A1F3D" Height="420">
                                <h:HelixViewport3D x:Name="HullViewport" ZoomExtentsWhenLoaded="True"
                                                    ShowCoordinateSystem="True"
                                                    CoordinateSystemHorizontalPosition="Left"
                                                    CoordinateSystemVerticalPosition="Bottom"
                                                    CoordinateSystemWidth="60" CoordinateSystemHeight="60"
                                                    CoordinateSystemLabelForeground="White"
                                                    ShowViewCube="True"
                                                    ViewCubeHorizontalPosition="Right"
                                                    ViewCubeVerticalPosition="Top"
                                                    Background="Transparent">
                                    <h:HelixViewport3D.Camera>
                                        <PerspectiveCamera Position="30,-220,140" LookDirection="-30,220,-140" UpDirection="0,0,1" FieldOfView="45"/>
                                    </h:HelixViewport3D.Camera>
                                    <h:SunLight/>
                                    <ModelVisual3D Content="{Binding HullModel}"/>
                                </h:HelixViewport3D>
                            </Border>
                            <TextBlock Foreground="#8FA6C9" FontSize="10.5" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.8"
                                       Text="Simplified parametric hull shell generated live from Lpp/B/D/T and the Cb/Cm/Cwp coefficients (station-based, power-law sections) — a modelling aid for visual proportion checks, not a faired lines plan or offset table. Gold plane marks the design waterline."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Quick Derived Parameters" Style="{StaticResource SectionTitleStyle}"/>
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Volume ∇ (m³)" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding VolumeDisplacement, StringFormat=N1}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Displacement Δ (t)" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding Displacement, StringFormat=N1}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Freeboard D−T (m)" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding Freeboard, StringFormat=N2}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="L/B Ratio" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding LengthBreadthRatio, StringFormat=N3}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="B/T Ratio" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding BreadthDraftRatio, StringFormat=N3}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="D/T Ratio" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding DepthDraftRatio, StringFormat=N3}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Froude Number Fn" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding FroudeNumber, StringFormat=N4}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Speed–Length Ratio" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding SpeedLengthRatio, StringFormat=N3}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Cp Calculated (Cb/Cm)" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding CalculatedCp, StringFormat=N4}" Style="{StaticResource StatValueStyle}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Source Scope" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Foreground="#D7E1F0" FontSize="13" TextWrapping="Wrap"
                                       Text="Implemented directly from Naval Architecture Teaching Toolkit Volume 1, VESSEL PARAMETERS sheet. This screen reproduces the workbook inputs and cells C26:C34. Constants follow the workbook exactly: seawater density 1.025 t/m³, 0.5144 m/s per knot, and g = 9.81 m/s²."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
